<launch>

  <!-- KISS-ICP odometry node 1 - oculii radar -->
  <include file="$(find kiss_icp)/launch/odometry.launch">
    <arg name="topic" value="/radar_enhanced_pcl2"/>
    <arg name="dataset_type" value="livox"/>
  </include>

  <!-- KISS-ICP odometry node 2 - livox lidar -->
  <include file="$(find genz_icp)/launch/odometry.launch">
    <arg name="topic" value="/livox/points"/>
    
  </include>

  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_se" clear_params="true">
    <rosparam command="load" file="$(find robot_localization)/params/ekf_template.yaml" />

    <remap from="odometry/filtered" to="/odometry/filtered"/>
    <!--  Placeholder for input topic remapping 
    <remap from="accel/filtered" to=""/>
    -->

  </node>
</launch>
