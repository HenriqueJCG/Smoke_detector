<launch>
<!-- Launch file for ouster OS2-64 LiDAR -->

    <arg name="rviz" default="true" />

    <rosparam command="load" file="$(find fast_lio)/config/ouster64.yaml" />
    <param name="use_sim_time" value="true"/>

    <param name="feature_extract_enable" type="bool" value="0"/>
    <param name="point_filter_num" type="int" value="4"/>
    <param name="max_iteration" type="int" value="3" />
    <param name="filter_size_surf" type="double" value="0.5" />
    <param name="filter_size_map" type="double" value="0.5" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_tf" args="0 0 0 0 0 0 body base_link" />
    <node pkg="detection_alg" type="text_marker.py" name="text_marker_node" output="screen"/>
    <node pkg="detection_alg" type="detection.py" name="detection_node" output="screen">
		<param name="mode" value="ouster"/>
	</node>

    </group>

    <arg name="path" default="/home/Datasets/"/>

    <arg name = "file_0" default = "Forest_Eskilstuna/Eskilstuna_Forest_0.bag"/> 
    <arg name = "file_1" default = "Forest_Eskilstuna/Eskilstuna_Forest_1.bag"/> 
    <arg name = "file_2" default = "Forest_Eskilstuna/Eskilstuna_Forest_2.bag"/> 
    <arg name = "file_3" default = "Forest_Eskilstuna/Eskilstuna_Forest_3.bag"/> 
    <arg name = "file_4" default = "Forest_Eskilstuna/Eskilstuna_Forest_4.bag"/> 
    <node pkg="rosbag" type="play" name="player" 
        args = "--clock $(arg path)$(arg file_0) $(arg path)$(arg file_1) $(arg path)$(arg file_2) $(arg path)$(arg file_3) $(arg path)$(arg file_4)">
    </node>
    


    <!-- <arg name = "file_0" default = "MSCRad4r/SMOKE_B0.bag"/> 
    <arg name = "file_1" default = "MSCRad4r/SMOKE_A0.bag"/> 
    <node pkg="rosbag" type="play" name="player" 
        args = "- -clock $(arg path)$(arg file_0) $(arg path)$(arg file_1)">
    </node>

    <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_tf"
          args="0 0 0 0 0 0 base_link os_sensor" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="radar_tf"
          args="0 0 0 1.5708 3.14 1.5708 base_link oculii" />-->

</launch>
